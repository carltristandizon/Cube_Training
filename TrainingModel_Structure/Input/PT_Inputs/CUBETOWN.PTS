;;<<PT>><<SYSTEM>>;;

;Transit Modes (1-99)
MODE NUMBER=1 LONGNAME="Rail Transit" NAME="Rail" 
MODE NUMBER=2 LONGNAME="Bus Transit" NAME="Bus" 

;Non-Transit Modes (>=100)
MODE NUMBER=100 LONGNAME="Walk Connectors" NAME="Walkcon" 
MODE NUMBER=200 LONGNAME="Transfers" NAME="Xfers" 
MODE NUMBER=201 LONGNAME="Auto Connectors" NAME="Autocon" 

;Wait Curves
WAITCRVDEF NUMBER=1 LONGNAME="InitialWait" NAME="IWAIT" ,
           CURVE=1-0.5,16-8,27-12,48-15,
           160-20
WAITCRVDEF NUMBER=2 LONGNAME="TransferWait" NAME="XWAIT" ,
           CURVE=1-0.5,4-2,12-6,20-8,
           40-15,60-20
